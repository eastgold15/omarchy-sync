# Installed copy: ~/.config/omarsync/scope
# This file stays on the machine. The copy inside a sync repository is ignored.
# Paths are relative to $HOME. Missing paths are skipped.
# Optional excludes follow a pipe and are comma-separated patterns
# (translated to mise dot exclude globs).
# .git directories and node_modules are always skipped.
# .ssh, .config/gh, .config/mise, key files, and the omarsync trust directory
# are rejected. Removing a line stops tracking that directory.
# The plugin directory (.config/omarchy/plugins) is never tracked by mise,
# even without the plugins/ exclude below; plugins sync only as signed
# snapshots, and ~/.config/omarsync/plugins-skip keeps machine-specific
# plugins out of the snapshot entirely.
# Machine-specific files are excluded by default: monitors.lua (display
# layout), input.lua (touchpad/keyboard), envs.lua (GPU/variables) differ
# per machine. Delete those patterns if you want them shared.

.config/omarchy | plugins/,*.bak.*,*-bak.*,*.mp4,*.mkv,*.webm,*.mov,*.avi,*.m4v
.config/hypr | *.bak.*,*-bak.*,monitors.lua,input.lua,envs.lua
.config/alacritty
.config/ghostty
.config/kitty
.config/foot
.config/nvim
.config/btop
.config/lazygit
.config/autostart
.local/share/flatpak/overrides
.config/systemd/user
.local/bin | agent,cursor,cursor-agent
.local/share/applications | mimeinfo.cache
.local/share/icons/hicolor | icon-theme.cache
