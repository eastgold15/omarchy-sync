{
  "name": "omarsync",
  "version": "3.0.0",
  "description": "Omarchy 配置同步薄壳:git 负责同步,mise dot 负责部署,Quickshell 面板负责展示",
  "type": "module",
  "bin": {
    "omarsync": "./dist/index.js"
  },
  "exports": {
    "import": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "packem build && node scripts/wrap-help.mjs && node scripts/split-large.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@visulima/cerebro": "^3.1.3",
    "@visulima/pail": "^5.0.1"
  },
  "devDependencies": {
    "@visulima/packem": "^3.0.0",
    "bun-types": "^1.4.3",
    "typescript": "^7.0.2",
    "esbuild": "^0.28.2"
  }
}
