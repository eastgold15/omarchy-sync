{
  "name": "omarsync",
  "version": "2.0.1",
  "description": "Omarchy 配置点对点同步 CLI(track 模式:推前手动存,拉后先审阅再应用,本机保留决定权)",
  "type": "module",
  "bin": {
    "omarsync": "./dist/index.js"
  },
  "exports": {
    "import": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "packem build && node scripts/wrap-help.mjs && node scripts/split-large.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@visulima/cerebro": "^3.1.3",
    "@visulima/command-line-args": "^2.0.1",
    "@visulima/error": "^6.1.0",
    "@visulima/fs": "^6.1.0",
    "@visulima/pail": "^5.0.1",
    "@visulima/path": "^4.0.0",
    "@visulima/tabular": "^4.1.0"
  },
  "devDependencies": {
    "@visulima/packem": "^3.0.0",
    "bun-types": "^1.4.3",
    "typescript": "^7.0.2",
    "esbuild": "^0.28.2"
  }
}
